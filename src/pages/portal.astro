---
import Base from '../layouts/Base.astro';
const title = 'Client portal — Track your matter | Lodgedwell';
const description = 'Sign in with your mobile number to follow every milestone of your Victorian conveyancing matter, from contract review to settlement.';
---
<Base title={title} description={description} active="" noindex={true}>
<main>
<section class="page-hero center">
  <span class="blob blob-1"></span>
  <span class="blob blob-2"></span>
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">Client portal</span>
      <h1>Track your matter</h1>
      <p class="lead">Sign in with the mobile number you gave us and follow every milestone of your conveyancing matter — no passwords, no phone tag.</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:8px">
  <div class="container" style="max-width:760px">

    <!-- Sign-in gate: same Twilio Verify flow as /get-started. -->
    <div class="form-embed-card" id="pt-gate">
      <div style="padding:34px 24px;max-width:440px;margin-inline:auto;text-align:center">
        <h3 style="margin:0 0 8px">Sign in with your mobile</h3>
        <p style="color:var(--muted);font-size:.95rem;margin:0 0 20px">We'll text a 6-digit code to the mobile number on your file. Enter it below to open your dashboard.</p>
        <div id="pt-step-phone">
          <input id="pt-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="e.g. 0412 345 678"
            style="width:100%;height:46px;border:1px solid var(--line);border-radius:10px;padding:0 14px;font:inherit;margin-bottom:12px" />
          <button id="pt-send" class="btn btn--block" type="button">Send code</button>
        </div>
        <div id="pt-step-code" hidden>
          <p style="font-size:.92rem;color:var(--muted);margin:0 0 12px">Code sent to <strong id="pt-sent-to"></strong>
            &middot; <button id="pt-change" type="button" style="background:none;border:0;padding:0;color:var(--green-700);font:inherit;font-weight:700;cursor:pointer">change number</button></p>
          <input id="pt-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456"
            style="width:100%;height:46px;border:1px solid var(--line);border-radius:10px;padding:0 14px;font:inherit;letter-spacing:.35em;text-align:center;margin-bottom:12px" />
          <button id="pt-check" class="btn btn--block" type="button">Sign in</button>
          <p style="margin:12px 0 0"><button id="pt-resend" type="button" style="background:none;border:0;padding:0;color:var(--green-700);font:inherit;font-size:.92rem;font-weight:700;cursor:pointer">Resend code</button></p>
        </div>
        <p id="pt-msg" role="status" aria-live="polite" style="min-height:1.3em;margin:14px 0 0;font-size:.9rem;color:var(--coral-600)"></p>
        <p style="margin:16px 0 0;font-size:.85rem;color:var(--muted)">Can't sign in? Email <a href="mailto:admin@lodgedwell.com.au" style="color:var(--green-700);font-weight:700">admin@lodgedwell.com.au</a> and we'll bring you up to speed.</p>
      </div>
    </div>

    <!-- Dashboard: revealed after sign-in, rendered by the script below. -->
    <div id="pt-dash" hidden>
      <div class="pt-bar">
        <span>Signed in as <strong id="pt-me" class="pt-mono"></strong></span>
        <button id="pt-signout" type="button">Sign out</button>
      </div>
      <div id="pt-matters"></div>
      <div id="pt-empty" class="form-embed-card" hidden>
        <div style="padding:34px 24px;max-width:460px;margin-inline:auto;text-align:center">
          <h3 style="margin:0 0 8px">No matters found yet</h3>
          <p style="color:var(--muted);font-size:.95rem;margin:0">We couldn't find an active matter for this mobile number. If you've just come on board it may not be linked yet — email <a href="mailto:admin@lodgedwell.com.au" style="color:var(--green-700);font-weight:700">admin@lodgedwell.com.au</a> and we'll sort it out.</p>
        </div>
      </div>
      <p style="text-align:center;margin-top:22px;font-size:.92rem;color:var(--muted)">
        Questions about a milestone? Email <a href="mailto:admin@lodgedwell.com.au" style="color:var(--green-700);font-weight:700">admin@lodgedwell.com.au</a>.
      </p>
    </div>

  </div>
</section>
</main>

<style is:global>
  /* Client-portal dashboard (elements are built by the script, so these
     rules are global rather than Astro-scoped). */
  .pt-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; font-size: .92rem; color: var(--muted); }
  .pt-bar button { background: none; border: 0; padding: 0; color: var(--green-700); font: inherit; font-weight: 700; cursor: pointer; }
  .pt-mono { font-family: var(--font-mono); font-weight: 500; color: var(--ink-700); }

  .pt-matter { background: var(--white); border: 1px solid var(--line-100); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: clamp(22px, 4vw, 34px); }
  .pt-matter + .pt-matter { margin-top: 22px; }
  .pt-matter-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
  .pt-matter h3 { margin: 0 0 4px; font-size: 1.35rem; }
  .pt-updated { margin: 0 0 20px; font-size: .88rem; color: var(--muted); }

  .pt-progress { height: 6px; background: var(--paper-sunk); border-radius: var(--radius-pill); overflow: hidden; margin: 0 0 26px; }
  .pt-progress span { display: block; height: 100%; background: var(--green-600); border-radius: var(--radius-pill); transition: width var(--dur-slow) var(--ease-out); }

  .pt-steps { list-style: none; margin: 0; padding: 0; }
  .pt-steps li { position: relative; padding: 0 0 26px 44px; }
  .pt-steps li:last-child { padding-bottom: 0; }
  /* connector line */
  .pt-steps li::before { content: ''; position: absolute; left: 13px; top: 30px; bottom: 2px; width: 2px; background: var(--line-200); }
  .pt-steps li:last-child::before { display: none; }
  .pt-steps li.done::before { background: var(--green-300); }

  .pt-dot { position: absolute; left: 0; top: 0; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0; border: 2px solid var(--line-200); background: var(--white); color: #fff; }
  .pt-dot svg { width: 14px; height: 14px; }
  li.done .pt-dot { background: var(--green-600); border-color: var(--green-600); }
  li.current .pt-dot { border-color: var(--ochre-500); }
  li.current .pt-dot::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--ochre-500); }

  .pt-steps strong { display: block; font-family: var(--font-display); font-weight: var(--fw-semibold); color: var(--ink-900); line-height: 1.3; }
  li.todo strong { color: var(--ink-400); }
  .pt-steps p { margin: 3px 0 0; font-size: .92rem; color: var(--ink-500); }
  li.todo p { color: var(--ink-300); }
  .pt-step-date { display: inline-block; margin-top: 5px; font-family: var(--font-mono); font-size: .8rem; color: var(--green-700); }
  li.current .pt-now { display: inline-block; margin-top: 5px; font-size: .8rem; font-weight: 700; color: var(--ochre-700); }
</style>

<script is:inline>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var TOKEN_KEY = 'lw-portal-token';
    var gate = $('pt-gate'), dash = $('pt-dash'), msg = $('pt-msg');
    var phone = '';

    function token() { try { return sessionStorage.getItem(TOKEN_KEY) || ''; } catch (e) { return ''; } }
    function setToken(t) { try { t ? sessionStorage.setItem(TOKEN_KEY, t) : sessionStorage.removeItem(TOKEN_KEY); } catch (e) {} }

    function busy(btn, on, label) { btn.disabled = on; btn.textContent = on ? 'Please wait…' : label; }
    function post(path, body, btn, label, cb) {
      msg.style.color = 'var(--coral-600)';
      msg.textContent = '';
      busy(btn, true, label);
      fetch('/.netlify/functions/' + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) { return r.json().then(function (d) { cb(r.ok, d); }); })
        .catch(function () { cb(false, { error: 'Network problem — please try again.' }); })
        .then(function () { busy(btn, false, label); });
    }

    /* ---- sign-in flow ---- */
    function sendCode(btn) {
      post('send-code', { phone: $('pt-phone').value }, btn, btn.textContent, function (ok, d) {
        if (!ok) { msg.textContent = d.error || 'Something went wrong.'; return; }
        phone = d.phone;
        $('pt-sent-to').textContent = phone;
        $('pt-step-phone').hidden = true;
        $('pt-step-code').hidden = false;
        $('pt-code').focus();
      });
    }
    $('pt-send').addEventListener('click', function () { sendCode(this); });
    $('pt-phone').addEventListener('keydown', function (e) { if (e.key === 'Enter') sendCode($('pt-send')); });
    $('pt-resend').addEventListener('click', function () {
      post('send-code', { phone: phone }, this, 'Resend code', function (ok, d) {
        msg.style.color = ok ? 'var(--green-700)' : 'var(--coral-600)';
        msg.textContent = ok ? 'A new code is on its way.' : (d.error || 'Something went wrong.');
      });
    });
    $('pt-change').addEventListener('click', function () {
      $('pt-step-code').hidden = true;
      $('pt-step-phone').hidden = false;
      msg.textContent = '';
      $('pt-phone').focus();
    });
    function signIn(btn) {
      post('portal-login', { phone: phone, code: $('pt-code').value }, btn, btn.textContent, function (ok, d) {
        if (!ok) { msg.textContent = d.error || 'Something went wrong.'; return; }
        setToken(d.token);
        loadMatters();
      });
    }
    $('pt-check').addEventListener('click', function () { signIn(this); });
    $('pt-code').addEventListener('keydown', function (e) { if (e.key === 'Enter') signIn($('pt-check')); });
    $('pt-signout').addEventListener('click', function () {
      setToken('');
      dash.hidden = true;
      gate.hidden = false;
      $('pt-step-code').hidden = true;
      $('pt-step-phone').hidden = false;
      msg.textContent = '';
    });

    /* ---- dashboard ---- */
    var CHECK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
    var TYPE_LABEL = { purchase: 'Purchase', sale: 'Sale', other: 'Matter' };

    function fmtDate(iso) {
      if (!iso) return '';
      var d = new Date(iso);
      if (isNaN(d)) return '';
      return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
    }
    function esc(s) {
      var div = document.createElement('div');
      div.textContent = s == null ? '' : String(s);
      return div.innerHTML;
    }

    function renderMatter(m) {
      var steps = m.milestones.map(function (s) {
        var extra = '';
        if (s.state === 'done' && s.completed_at) extra = '<span class="pt-step-date">' + esc(fmtDate(s.completed_at)) + '</span>';
        if (s.state === 'current') extra = '<span class="pt-now">In progress</span>';
        return '<li class="' + s.state + '"><span class="pt-dot" aria-hidden="true">' + (s.state === 'done' ? CHECK_SVG : '') + '</span>' +
          '<div><strong>' + esc(s.label) + '</strong><p>' + esc(s.blurb) + '</p>' + extra + '</div></li>';
      }).join('');
      var titleText = m.address || m.description || 'Your matter';
      var pct = m.progress.total ? Math.round((m.progress.done / m.progress.total) * 100) : 0;
      return '<article class="pt-matter">' +
        '<div class="pt-matter-head">' +
          '<span class="mock-badge" style="background:var(--green-100);color:var(--green-700)">' + esc(TYPE_LABEL[m.type] || 'Matter') + '</span>' +
          (m.display_number ? '<span class="pt-mono" style="font-size:.85rem;color:var(--muted)">' + esc(m.display_number) + '</span>' : '') +
        '</div>' +
        '<h3>' + esc(titleText) + '</h3>' +
        '<p class="pt-updated">' + (m.updated_at ? 'Last updated ' + esc(fmtDate(m.updated_at)) : '') + '</p>' +
        '<div class="pt-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + pct + '"><span style="width:' + pct + '%"></span></div>' +
        '<ol class="pt-steps">' + steps + '</ol>' +
        '</article>';
    }

    function loadMatters() {
      fetch('/.netlify/functions/portal-matters', {
        headers: { Authorization: 'Bearer ' + token() },
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, status: r.status, d: d }; }); })
        .then(function (out) {
          if (!out.ok) {
            setToken('');
            gate.hidden = false;
            dash.hidden = true;
            if (out.status === 401 && token()) msg.textContent = out.d.error || 'Please sign in again.';
            return;
          }
          $('pt-me').textContent = out.d.phone;
          $('pt-matters').innerHTML = out.d.matters.map(renderMatter).join('');
          $('pt-empty').hidden = out.d.matters.length > 0;
          gate.hidden = true;
          dash.hidden = false;
        })
        .catch(function () { msg.textContent = 'Network problem — please try again.'; });
    }

    if (token()) loadMatters();
  })();
</script>
</Base>
