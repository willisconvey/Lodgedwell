---
import Base from '../layouts/Base.astro';
const title = "Get started \u2014 Onboard online | Lodgedwell";
const description = "Start your Victorian conveyancing online. Complete our short buying or selling form and a licensed conveyancer will be in touch within one business day.";
---
<Base title={title} description={description} active="" tally={true}>
<main>
<section class="page-hero center">
  <span class="blob blob-1"></span>
  <span class="blob blob-2"></span>
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">Get started</span>
      <h1>Onboard online in minutes</h1>
      <p class="lead">Choose whether you're buying or selling and complete the guided form below. It's free to start, takes about 10 minutes, and a licensed Victorian conveyancer will be in touch within one business day.</p>
    </div>
    <div class="reveal" data-delay="1" style="margin-top:26px">
      <div class="tabs" role="tablist" aria-label="Choose a form">
        <button class="tab active" data-form-tab="buy" role="tab" aria-selected="true">I'm buying</button>
        <button class="tab" data-form-tab="sell" role="tab" aria-selected="false">I'm selling</button>
      </div>
    </div>
  </div>
</section>

<!-- FORMS -->
<section class="section" style="padding-top:8px">
  <div class="container" style="max-width:840px">
    <!-- BUY PANEL -->
    <div data-form-panel="buy" class="reveal">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap">
        <span class="mock-badge" style="background:var(--green-100);color:var(--green-700)">Buying questionnaire</span>
        <span style="font-size:.9rem;color:var(--muted)">Takes ~10 minutes · Save and resume any time</span>
      </div>
      <!-- Step 1: verify the mobile number (Twilio Verify via Netlify functions),
           then reveal the Jotform with the verified number passed through. -->
      <div class="form-embed-card" id="lw-verify-gate">
        <div style="padding:34px 24px;max-width:440px;margin-inline:auto;text-align:center">
          <h3 style="margin:0 0 8px">First, verify your mobile</h3>
          <p style="color:var(--muted);font-size:.95rem;margin:0 0 20px">We'll text you a 6-digit code so we know we can reach you about your purchase. It takes about 20 seconds.</p>
          <div id="lw-step-phone">
            <input id="lw-phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="e.g. 0412 345 678"
              style="width:100%;height:46px;border:1px solid var(--line);border-radius:10px;padding:0 14px;font:inherit;margin-bottom:12px" />
            <button id="lw-send" class="btn btn--block" type="button">Send code</button>
          </div>
          <div id="lw-step-code" hidden>
            <p style="font-size:.92rem;color:var(--muted);margin:0 0 12px">Code sent to <strong id="lw-sent-to"></strong>
              &middot; <button id="lw-change" type="button" style="background:none;border:0;padding:0;color:var(--green-700);font:inherit;font-weight:700;cursor:pointer">change number</button></p>
            <input id="lw-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456"
              style="width:100%;height:46px;border:1px solid var(--line);border-radius:10px;padding:0 14px;font:inherit;letter-spacing:.35em;text-align:center;margin-bottom:12px" />
            <button id="lw-check" class="btn btn--block" type="button">Verify and start the form</button>
            <p style="margin:12px 0 0"><button id="lw-resend" type="button" style="background:none;border:0;padding:0;color:var(--green-700);font:inherit;font-size:.92rem;font-weight:700;cursor:pointer">Resend code</button></p>
          </div>
          <p id="lw-msg" role="status" aria-live="polite" style="min-height:1.3em;margin:14px 0 0;font-size:.9rem;color:var(--coral-600)"></p>
          <p style="margin:16px 0 0;font-size:.85rem;color:var(--muted)">Not receiving the code? Call <a href="tel:1300000000" style="color:var(--green-700);font-weight:700">1300 000 000</a> and we'll help you continue.</p>
        </div>
      </div>
      <div class="form-embed-card" id="lw-form-card" hidden>
        <iframe
          id="JotFormIFrame-262051079065050"
          title="Lodgedwell purchase form"
          allow="geolocation; microphone; camera; fullscreen; payment"
          data-jotform-src="https://form.jotform.com/262051079065050"
          style="min-width:100%;max-width:100%;height:760px;border:none"
          scrolling="no"></iframe>
      </div>
      <script is:inline src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
      <script is:inline>
        (function () {
          var $ = function (id) { return document.getElementById(id); };
          var gate = $('lw-verify-gate'), card = $('lw-form-card'), msg = $('lw-msg');
          var verified = '';
          try { verified = sessionStorage.getItem('lw-verified-phone') || ''; } catch (e) {}

          function showForm(phone) {
            var frame = $('JotFormIFrame-262051079065050');
            var src = frame.getAttribute('data-jotform-src');
            if (phone) src += '?phone7[full]=' + encodeURIComponent(phone);
            frame.src = src;
            gate.hidden = true;
            card.hidden = false;
            if (window.jotformEmbedHandler) {
              window.jotformEmbedHandler("iframe[id='JotFormIFrame-262051079065050']", 'https://form.jotform.com/');
            }
          }

          if (verified) { showForm(verified); return; }

          var phone = '';
          function busy(btn, on, label) { btn.disabled = on; btn.textContent = on ? 'Please wait…' : label; }
          function post(path, body, btn, label, cb) {
            msg.textContent = '';
            busy(btn, true, label);
            fetch('/.netlify/functions/' + path, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            }).then(function (r) { return r.json().then(function (d) { cb(r.ok, d); }); })
              .catch(function () { cb(false, { error: 'Network problem — please try again.' }); })
              .then(function () { busy(btn, false, label); });
          }

          function sendCode(btn) {
            post('send-code', { phone: $('lw-phone').value }, btn, btn.textContent, function (ok, d) {
              if (!ok) { msg.textContent = d.error || 'Something went wrong.'; return; }
              phone = d.phone;
              $('lw-sent-to').textContent = phone;
              $('lw-step-phone').hidden = true;
              $('lw-step-code').hidden = false;
              $('lw-code').focus();
            });
          }

          $('lw-send').addEventListener('click', function () { sendCode(this); });
          $('lw-phone').addEventListener('keydown', function (e) { if (e.key === 'Enter') sendCode($('lw-send')); });
          $('lw-resend').addEventListener('click', function () {
            post('send-code', { phone: phone }, this, 'Resend code', function (ok, d) {
              msg.style.color = ok ? 'var(--green-700)' : 'var(--coral-600)';
              msg.textContent = ok ? 'A new code is on its way.' : (d.error || 'Something went wrong.');
            });
          });
          $('lw-change').addEventListener('click', function () {
            $('lw-step-code').hidden = true;
            $('lw-step-phone').hidden = false;
            msg.textContent = '';
            $('lw-phone').focus();
          });

          function checkCode(btn) {
            msg.style.color = 'var(--coral-600)';
            post('check-code', { phone: phone, code: $('lw-code').value }, btn, btn.textContent, function (ok, d) {
              if (!ok) { msg.textContent = d.error || 'Something went wrong.'; return; }
              try { sessionStorage.setItem('lw-verified-phone', d.phone); } catch (e) {}
              showForm(d.phone);
            });
          }
          $('lw-check').addEventListener('click', function () { checkCode(this); });
          $('lw-code').addEventListener('keydown', function (e) { if (e.key === 'Enter') checkCode($('lw-check')); });
        })();
      </script>
      <p style="text-align:center;margin-top:18px;font-size:.92rem;color:var(--muted)">
        Prefer to talk first? Call <a href="tel:1300000000" style="color:var(--green-700);font-weight:700">1300 000 000</a> or email <a href="mailto:hello@lodgedwell.com.au" style="color:var(--green-700);font-weight:700">hello@lodgedwell.com.au</a>.
      </p>
    </div>

    <!-- SELL PANEL -->
    <div data-form-panel="sell" hidden>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap">
        <span class="mock-badge" style="background:var(--coral-100);color:var(--coral-600)">Property sales form</span>
        <span style="font-size:.9rem;color:var(--muted)">Takes ~10 minutes · Save and resume any time</span>
      </div>
      <div class="form-embed-card">
        <iframe
          data-tally-src="https://tally.so/embed/9q5aBQ?alignLeft=1&amp;hideTitle=1&amp;transparentBackground=1&amp;dynamicHeight=1"
          loading="lazy"
          title="Lodgedwell property sales form"
          height="760"></iframe>
      </div>
      <p style="text-align:center;margin-top:18px;font-size:.92rem;color:var(--muted)">
        Prefer to talk first? Call <a href="tel:1300000000" style="color:var(--green-700);font-weight:700">1300 000 000</a> or email <a href="mailto:hello@lodgedwell.com.au" style="color:var(--green-700);font-weight:700">hello@lodgedwell.com.au</a>.
      </p>
    </div>
  </div>
</section>

<!-- WHAT HAPPENS NEXT -->
<section class="section" style="background:var(--cream-200);border-block:1px solid var(--line);padding-top:clamp(48px,6vw,80px)">
  <div class="container">
    <div class="section-head center reveal" style="margin-bottom:44px">
      <span class="eyebrow">After you submit</span>
      <h2>What happens next</h2>
    </div>
    <div class="grid cols-3" style="max-width:940px;margin-inline:auto">
      <div class="card step-card reveal"><span class="step-num">1</span>
        <h3>We review your details</h3>
        <p>A licensed conveyancer checks everything you've submitted and confirms your fixed-fee quote.</p>
      </div>
      <div class="card step-card reveal" data-delay="1"><span class="step-num">2</span>
        <h3>We reach out</h3>
        <p>Within one business day you'll hear from a named conveyancer to introduce themselves and next steps.</p>
      </div>
      <div class="card step-card reveal" data-delay="2"><span class="step-num">3</span>
        <h3>You track it all</h3>
        <p>Once you're on board, follow every milestone through to settlement from your online dashboard.</p>
      </div>
    </div>
  </div>
</section>

<!-- TRUST STRIP -->
<section class="trust">
  <div class="container trust-inner">
    <span class="trust-label">You're in safe hands</span>
    <div class="trust-items">
      <span class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Encrypted &amp; secure</span>
      <span class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Free, no-obligation quote</span>
      <span class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 6 6 .9-4.5 4.3 1 6.3L12 17l-5.5 2.5 1-6.3L3 8.9 9 8z"/></svg> Rated 4.9★ by Victorians</span>
    </div>
  </div>
</section>
</main>
</Base>
