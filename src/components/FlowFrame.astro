---
// Outer wrapper for the purchase flow: hosts an inner step page in an iframe
// so Tally's between-step redirects stay contained inside the card. Forwards
// the host page's query string to the inner page (which Tally's embed script
// then forwards into the form's hidden fields), mirrors the inner page's
// height, and keeps the card in view when a new step loads.
const { step, title } = Astro.props;
---
<div class="form-embed-card">
  <iframe class="lw-flow-frame" data-flow-src={step} title={title} height="600"></iframe>
</div>
<script is:inline>
  (function () {
    var frame = document.currentScript.previousElementSibling.querySelector('iframe');
    frame.src = frame.getAttribute('data-flow-src') + window.location.search;
    window.addEventListener('message', function (e) {
      if (e.origin !== window.location.origin) return;
      var d = e.data || {};
      if (d.type === 'lw-flow-height' && typeof d.height === 'number' && d.height > 40) {
        frame.style.height = Math.ceil(d.height) + 'px';
      } else if (d.type === 'lw-flow-step') {
        var r = frame.getBoundingClientRect();
        if (r.top < 0 || r.top > window.innerHeight * 0.6) {
          window.scrollTo({ top: r.top + window.scrollY - 90, behavior: 'smooth' });
        }
      }
    });
  })();
</script>
