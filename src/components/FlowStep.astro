---
// Chrome-less inner page for one step of the purchase flow. Rendered inside
// the outer FlowFrame iframe, so Tally's redirect-on-completion only
// navigates this page and the visible site page never changes.
// `fallback` is the branded page wrapping this step: if this page is ever
// opened as the top-level window (direct link, tally.so-hosted form, stale
// cache of a pre-FlowFrame page), it forwards there instead of showing a
// bare embed.
const { formId, title, fallback } = Astro.props;
---
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex" />
  <script is:inline define:vars={{ fallback }}>
    if (window === window.top) {
      window.location.replace(fallback + window.location.search);
    }
  </script>
  <style>
    html, body { margin: 0; padding: 0; background: transparent; overflow: hidden; }
    iframe { width: 100%; border: 0; display: block; }
  </style>
</head>
<body>
  <iframe
    data-tally-src={`https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
    title={title}
    height="400"></iframe>
  <script is:inline src="https://tally.so/widgets/embed.js" defer></script>
  <script is:inline>
    (function () {
      var send = function () {
        parent.postMessage(
          { type: 'lw-flow-height', height: document.body.scrollHeight },
          '*'
        );
      };
      new ResizeObserver(send).observe(document.body);
      window.addEventListener('load', send);
      // Tally's embed script resizes its iframe on messages from tally.so;
      // relay the new height just after each one (ResizeObserver alone can
      // miss changes while the page is backgrounded).
      window.addEventListener('message', function (e) {
        if (typeof e.origin === 'string' && e.origin.indexOf('tally.so') !== -1) {
          setTimeout(send, 50);
        }
      });
      parent.postMessage({ type: 'lw-flow-step' }, '*');
    })();
  </script>
</body>
</html>
